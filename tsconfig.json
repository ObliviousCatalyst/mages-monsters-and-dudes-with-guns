{
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"outDir": "./bin",
		"rootDir": "./src",
		"esModuleInterop": true,
		"allowJs": true,
		"sourceMap": false,
		"declarationMap": false,
		"declaration": false,
		"removeComments": true,

		"types": [],
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,// Recommended Options
		"strict": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
	},
	"include": ["src/**/*"],
	"exclude": ["bin/*","assets/*"],
}
