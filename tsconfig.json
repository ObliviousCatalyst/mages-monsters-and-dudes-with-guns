{
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"outDir": "./bin",
		"rootDir": "./src",
		"esModuleInterop": true,

		"types": [],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,// Stricter Typechecking Options
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,// Recommended Options
		"strict": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
	},
	"include": ["src/**/*", "assets/serverside_ui", "assets/clientside"],
	"exclude": ["bin/*"],
}
